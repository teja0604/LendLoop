# ==============================================================================
# LendLoop - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT store actual production credentials or private keys in this file.
# ==============================================================================

# Clerk Authentication (Configured in Phase 2)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Convex Backend & Database (Configured in Phase 3)
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
CONVEX_DEPLOYMENT=dev:placeholder
CONVEX_SITE_URL=https://placeholder.convex.site

# n8n Automation Engine (Configured in Phase 7)
# Generate a strong 32-byte HMAC secret using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_HMAC_SECRET=replace_with_generated_32_byte_hex_secret
N8N_ENCRYPTION_KEY=replace_with_generated_32_byte_encryption_key

# Notification Provider Credentials (SMTP)
# Configure these in n8n UI under Credentials > SMTP > "LendLoop SMTP Account"
# (or pass to container for environment-based workflow integrations)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_SENDER_EMAIL=notifications@lendloop.org

# Timezone Configuration (Consistent ISO date handling)
APP_TIME_ZONE=UTC
GENERIC_TIMEZONE=UTC
