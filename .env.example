# ==============================================================================
# LendLoop — Environment Configuration Template (.env.example)
# ==============================================================================
# This template documents all verified environment variables consumed across LendLoop.
#
# CRITICAL CONFIGURATION SEPARATION:
# LendLoop consists of multiple distinct runtime environments. Variables are NOT
# all placed into a single file. You must configure them in their respective locations:
#
# 1. Root `.env.local`
#    - Consumed by: Next.js (App Router, React client components, SSR, and proxy.ts).
#    - Used for: Local Next.js development (`npm run dev`, `npm run build`).
#    - In production (e.g., Vercel), configure these in your hosting dashboard.
#
# 2. Root `.env`
#    - Consumed by: Docker Compose (`docker-compose.yml`).
#    - Used for: Interpolating container environment variables for n8n.
#    - NOTE: Next.js and Convex DO NOT read variables from root `.env`.
#
# 3. Convex Cloud Dashboard (or via `npx convex env set <KEY> <VALUE>`)
#    - Consumed by: Convex serverless functions (convex/outbox.ts, convex/http.ts, convex/auth.config.ts).
#    - NOTE: Convex runs in the cloud; it DOES NOT read local `.env` or `.env.local` at runtime.
#
# 4. n8n Internal Credential Storage (n8n Web UI)
#    - Consumed by: n8n workflow nodes (`emailSend`).
#    - Configured at: `http://127.0.0.1:5678/credentials` under credential ID `lendloop-smtp-credential`.
#    - NOTE: Setting SMTP variables in `.env` does NOT create or update n8n credentials.
#
# WARNING: NEVER COMMIT SENSITIVE VALUES (API KEYS, SECRETS, PASSWORDS) TO GIT.
# ==============================================================================


# ==============================================================================
# 1. NEXT.JS APPLICATION & CONVEX CLIENT
# ==============================================================================
# Configure in: Root `.env.local` (Local) / Hosting Dashboard (Production)
# Consumed by: Next.js App Router and React client provider

# [REQUIRED] Convex Deployment HTTP/WebSocket URL
# Points the client ConvexReactClient to your Convex backend cloud deployment.
# Consumed in: `src/providers/convex-client-provider.tsx`
# Local Development: Obtained when running `npx convex dev` (e.g., https://hardy-stoat-156.ap-southeast-2.convex.cloud)
# Production: Obtained from Convex Dashboard when running `npx convex deploy`
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-deployment.convex.cloud

# [REQUIRED FOR CONVEX CLI] Convex Project Deployment Identifier
# Used by the Convex CLI (`npx convex dev`, `npx convex deploy`) to link the repository to your Convex project.
# Format: `dev:<deployment-name>` or `prod:<deployment-name>`
CONVEX_DEPLOYMENT=dev:replace-with-your-deployment-name


# ==============================================================================
# 2. CLERK AUTHENTICATION
# ==============================================================================
# Configure in: Root `.env.local` (Local) / Hosting Dashboard (Production)
# Consumed by: @clerk/nextjs (src/proxy.ts, src/providers/convex-client-provider.tsx, Clerk UI components)

# [REQUIRED] Clerk Frontend Publishable Key
# Public API key for the Clerk client SDK.
# Development format: pk_test_...
# Production format:  pk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# [REQUIRED - SECRET] Clerk Backend API Secret Key
# Server-side secret key used by Clerk middleware (src/proxy.ts) and server APIs.
# NEVER expose this key to the browser or prefix with NEXT_PUBLIC_.
# Development format: sk_test_...
# Production format:  sk_live_...
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key

# [OPTIONAL] Clerk Authentication Route Paths
# Standard Next.js route configurations for LendLoop auth flows.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ------------------------------------------------------------------------------
# Administrator Initial Bootstrap Note:
# LendLoop does NOT read an initial administrator ID from environment variables
# at runtime. The bootstrapAdmin internal mutation in `convex/users.ts` strictly
# accepts `clerkUserId` as a direct invocation argument.
#
# To bootstrap your initial administrator:
# 1. Sign in once to the application via Clerk to provision your user record.
# 2. Run the internal mutation via the Convex CLI with your Clerk User ID:
#    npx convex run users:bootstrapAdmin '{"clerkUserId": "user_replace_with_admin_clerk_id"}'
# ------------------------------------------------------------------------------


# ==============================================================================
# 3. CONVEX BACKEND CLOUD ENVIRONMENT
# ==============================================================================
# Configure in: Convex Dashboard > Project Settings > Environment Variables
# Or via CLI:  `npx convex env set <NAME> <VALUE>`
# Consumed by: Convex Cloud serverless functions (convex/outbox.ts, convex/http.ts, convex/auth.config.ts)
# NOTE: DO NOT place these in `.env.local` expecting Convex cloud to read them.

# [REQUIRED] Ingress Webhook URL for n8n
# The full public webhook base URL reachable by Convex Cloud to dispatch outbox events.
# Development: Ephemeral or persistent tunnel URL (e.g., https://your-tunnel.trycloudflare.com/webhook)
# Production:  Permanent domain URL through Nginx proxy (e.g., https://webhook.lendloop.org/webhook)
# Consumed by: convex/outbox.ts (processOutboxBatch)
N8N_WEBHOOK_URL=https://replace-with-your-public-webhook-domain.com/webhook

# [REQUIRED - SECRET] Shared HMAC-SHA256 Secret
# 32-byte (64 hex characters) cryptographically random shared secret.
# Used by `convex/outbox.ts` to sign dispatched webhook events (X-LendLoop-Signature)
# and by `convex/http.ts` to verify incoming activity write-back callbacks from n8n.
# MUST MATCH EXACTLY the `N8N_WEBHOOK_HMAC_SECRET` configured in root `.env` for Docker Compose!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_HMAC_SECRET=replace_with_32_byte_hex_hmac_secret_must_match_docker_env

# [OPTIONAL / PRODUCTION REQUIRED] Clerk JWT Issuer Domain
# Consumed by: convex/auth.config.ts to validate Clerk user JWTs.
# Defaults to "https://clerk.lendloop.dev" if unset in development.
# In production, set to your Clerk Frontend API URL (e.g., https://clerk.lendloop.org or https://verb-noun-00.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=https://replace-with-your-clerk-frontend-api.clerk.accounts.dev


# ==============================================================================
# 4. DOCKER COMPOSE AND N8N ENGINE
# ==============================================================================
# Configure in: Root `.env` (Used by `docker compose up -d`)
# Consumed by: docker-compose.yml to interpolate environment into `lendloop-n8n` container.
# NOTE: Next.js and Convex DO NOT read root `.env`.

# [REQUIRED - SECRET] n8n Webhook HMAC Shared Secret
# Shared secret passed into n8n container to allow Code nodes to verify incoming Convex webhook
# signatures and sign outgoing activity write-back requests.
# MUST MATCH EXACTLY the `N8N_WEBHOOK_HMAC_SECRET` configured in the Convex Cloud Dashboard!
N8N_WEBHOOK_HMAC_SECRET=replace_with_32_byte_hex_hmac_secret_must_match_convex_dashboard

# [REQUIRED] Convex Site URL for Activity Write-Back Callbacks
# Base URL where Convex HTTP actions are hosted (e.g., https://hardy-stoat-156.ap-southeast-2.convex.site).
# n8n workflows POST activity results to `${CONVEX_SITE_URL}/api/webhooks/n8n/activity`.
# Consumed by: All 4 n8n workflows (HTTP Request node expression: $env.CONVEX_SITE_URL)
CONVEX_SITE_URL=https://replace-with-your-deployment.convex.site

# [OPTIONAL] Outgoing Sender Email Address
# Address shown in the `From:` header of outgoing notification emails.
# Consumed by: n8n workflow emailSend node expression: `{{ $env.SMTP_SENDER_EMAIL || $env.SMTP_USER }}`.
# Defaults to SMTP_USER if omitted.
SMTP_SENDER_EMAIL=notifications@example.com

# [OPTIONAL] Outgoing Sender Email Username Fallback
# Fallback email address for the `From:` header if `SMTP_SENDER_EMAIL` is not set.
# Consumed by: n8n workflow emailSend node expression: `{{ $env.SMTP_SENDER_EMAIL || $env.SMTP_USER }}`.
SMTP_USER=replace_with_your_sender_address@example.com


# ==============================================================================
# 5. n8n SMTP CREDENTIAL MANAGER (MANUAL SETUP IN n8n UI)
# ==============================================================================
# IMPORTANT ARCHITECTURAL DISTINCTION:
# Setting SMTP variables in `.env` DOES NOT configure or update n8n's SMTP credential.
#
# n8n workflow emailSend nodes authenticate against external mail relays using an
# internal encrypted credential stored in n8n's credential database, identified as:
#   Credential Name: LendLoop SMTP Account
#   Credential ID:   lendloop-smtp-credential
#
# (In docker-compose.yml, SMTP_HOST, SMTP_PORT, and SMTP_PASSWORD are container
# passthroughs with default fallbacks; they are not read by workflow expressions
# or Code nodes and do not populate the n8n credential vault.)
#
# MANUAL SETUP PROCEDURE:
# 1. Open the n8n web console: http://127.0.0.1:5678
# 2. In the left navigation sidebar, click "Credentials" -> "Add Credential".
# 3. Search for and select "SMTP".
# 4. Fill in the connection parameters:
#    - Credential Name: LendLoop SMTP Account
#    - Host:            Your SMTP host (e.g., smtp.mailgun.org, smtp.sendgrid.net, smtp.postmarkapp.com, mailpit)
#    - Port:            587 (STARTTLS) or 465 (SSL/TLS)
#    - User:            Your SMTP account username or API key
#    - Password:        Your SMTP account password or API key secret
#    - SSL/TLS:         Toggle based on your provider requirements
# 5. Click "Save" and test the connection.
# 6. Verify that each imported workflow (A, B, C, D) has its "Send Email" node bound
#    to this "LendLoop SMTP Account" credential.
# ==============================================================================
